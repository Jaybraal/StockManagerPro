# StockManagerPro - Variables de Entorno
# Copia este archivo como .env y configura los valores reales
# NUNCA commitees el archivo .env al repositorio

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL=postgresql://usuario:contraseña@localhost/stockmanagerpro

# ============================================
# SEGURIDAD JWT
# ============================================
# JWT Secret Key (genera una clave segura de al menos 32 caracteres)
# Puedes generar una con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_SEGURA_DE_64_CARACTERES

# CSRF Secret Key (puede ser diferente de JWT)
CSRF_SECRET_KEY=CAMBIA_ESTA_CLAVE_CSRF_SEGURA

# ============================================
# CONFIGURACIÓN DE COOKIES (Seguridad)
# ============================================
# En producción (HTTPS) cambiar a True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ============================================
# EMAIL (opcional, para notificaciones)
# ============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_email@gmail.com
# Para Gmail, usa una "Contraseña de aplicación" no tu contraseña normal
# https://support.google.com/accounts/answer/185833
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_DEFAULT_SENDER=tu_email@gmail.com

# ============================================
# FRONTEND
# ============================================
# Clave de encriptación para datos offline
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(16))"
REACT_APP_ENCRYPTION_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_SEGURA

# URL de la API (dejar vacío si es el mismo servidor)
REACT_APP_API_URL=

# ============================================
# ENTORNO
# ============================================
FLASK_ENV=development
NODE_ENV=development

# CORS Origins (separados por coma para múltiples orígenes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Puerto del backend
BACKEND_PORT=5001

# Puerto del frontend
FRONTEND_PORT=3000
